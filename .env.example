# Copy this file to .env and fill in real values.

# Server
PORT=3000

# Default search origin (can be overridden per-request from the UI)
DEFAULT_ADDRESS="3051 Adeline Ave, Berkeley, CA"
DEFAULT_RADIUS_MILES=50

# --- Scraper API (Apify) ---
# Sign up at https://apify.com, create an API token under Settings > Integrations.
APIFY_TOKEN=

# Actor picks (checked on the Apify Store, July 2026) -- see README for how
# each was evaluated and what to check if you swap in a different one.
# If left blank, the app falls back to built-in mock/demo data for that source.
APIFY_ACTOR_FACEBOOK=apify/facebook-marketplace-scraper
APIFY_ACTOR_CRAIGSLIST=ivanvs/craigslist-scraper-pay-per-result
APIFY_ACTOR_OFFERUP=igolaizola/offerup-scraper

# Craigslist scopes search to a regional subdomain, not lat/lon. "sfbay"
# covers Berkeley/Oakland/SF -- change it if you're searching elsewhere.
CRAIGSLIST_REGION=sfbay

# Facebook Marketplace scopes search to a city "slug" in the URL, which
# doesn't map cleanly from an address. Browse facebook.com/marketplace
# yourself, pick your location, and copy the slug from the resulting URL
# (e.g. facebook.com/marketplace/oakland/... -> "oakland"). Left blank on
# purpose -- guessing wrong silently returns the wrong city's listings.
FACEBOOK_MARKETPLACE_CITY_SLUG=

# OfferUp's actor wants a zip code. Leave blank to have the app derive one
# automatically from DEFAULT_ADDRESS (via reverse geocoding), or set one
# explicitly here to skip that lookup.
OFFERUP_ZIP_CODE=

# Nextdoor has no viable public scraping actor (listings sit behind an
# authenticated, geo-verified neighborhood session). The Nextdoor "adapter" in
# this app is a manual-paste workflow instead -- see README.
